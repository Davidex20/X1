<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-feature android:name="android.hardware.camera" android:required="false"/>
  <queries>
    <package android:name="com.whatsapp"/>
    <package android:name="com.google.android.apps.tachyon"/>
    <package android:name="com.google.android.apps.meetings"/>
  </queries>
  <application android:theme="@android:style/Theme.Material.NoActionBar"
    android:label="Xpheasible Call Studio"
    android:usesCleartextTraffic="false"
    android:allowBackup="false"
    android:icon="@android:drawable/ic_menu_camera">
    <activity android:name=".DesktopBrowserActivity" android:exported="false"
      android:resizeableActivity="true"
      android:supportsPictureInPicture="true"
      android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"/>
    <activity android:name=".StageActivity" android:exported="false"
      android:configChanges="orientation|screenSize|keyboardHidden"/>
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
